PORT=3001
ANTHROPIC_API_KEY=
# claude-haiku-4-5 es el más económico; sube a claude-sonnet-5 si el triage falla
ANTHROPIC_MODEL=claude-haiku-4-5
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
FRONTEND_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lablens
# SMTP is optional: leave blank and the triage still routes, only the email is skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LabLens <no-reply@lablens.local>
PUBLIC_SUBMISSION_RATE_LIMIT=10
