generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EVALUATOR
  ADMIN
}

enum InitiativeStatus {
  DRAFT
  REGISTERED
  TRIAGED_LAB
  TRIAGED_EXTERNAL
  UNDER_REVIEW
  EVALUATED
  APPROVED
  REJECTED
  ARCHIVED
}

enum SourceType {
  INTERNAL
  EXTERNAL_CONTRACTOR
  INTERNATIONAL_REFERENCE
}

enum EvaluationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  COLLECTING_INFORMATION
  READY_TO_EVALUATE
  COMPLETED
}

enum MessageRole {
  user
  assistant
  system
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(EVALUATOR)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  initiatives   Initiative[]
  evaluations   Evaluation[]   @relation("EvaluationEvaluator")
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Initiative {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String?          @db.Uuid
  status                InitiativeStatus @default(DRAFT)
  sourceType            SourceType       @default(INTERNAL)
  diligenciadoPor       String           @default("")
  fechaDiligenciamiento DateTime         @default(now())
  expectativaSolucion   String           @default("")
  nombre                String           @default("")
  areaProcesoImpactado  String           @default("")
  areaInvolucrada       String           @default("")
  urgencia              String           @default("")
  impacto               String           @default("")
  necesidad             String           @default("")
  porQueAhora           String           @default("")
  paraQue               String           @default("")
  comoSeResuelveHoy     String           @default("")

  // Formulario público de 12 preguntas. Los de opción cerrada se guardan
  // estructurados (no como prosa) para poder filtrarlos y graficarlos.
  // El formulario interno no los diligencia, de ahí los defaults vacíos.
  areaSolicitante     String   @default("") // Área de quien envía
  solucionPropuesta   String   @default("") // Solución que propone
  impactaA            String[] @default([]) // A quién impacta (selección múltiple)
  productoRelacionado String[] @default([]) // Productos ACH (selección múltiple)
  beneficios          String[] @default([]) // Selección múltiple
  tieneInteresado     Boolean? // ¿Existe cliente, aliado o área interesada?

  // Solo para sourceType = INTERNATIONAL_REFERENCE
  referenceOrganization String?
  referenceEvent        String?
  referenceLink         String?
  referenceRationale    String?

  // Contacto del submisor cuando la iniciativa llega por el canal público (userId nulo)
  submitterName  String?
  submitterEmail String?

  // Linaje de copias. Una iniciativa triada queda como registro inmutable de lo
  // que se envió; para iterar sobre ella se saca una copia editable. La copia
  // conserva de dónde salió para poder comparar el antes y el después.
  copiedFromId String? @db.Uuid

  // Triage rápido: una sola pasada del LLM, independiente del pipeline de evaluación
  triageClassificationId String?   @db.Uuid
  triageWorkTableId      String?   @db.Uuid
  triageReasoning        String?
  triageConfidence       Float?
  triagedAt              DateTime?
  notificationSentAt     DateTime?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  triageClassification IntelligentClassification? @relation("InitiativeTriageClassification", fields: [triageClassificationId], references: [id], onDelete: SetNull)
  triageWorkTable      WorkTable?       @relation("InitiativeTriageWorkTable", fields: [triageWorkTableId], references: [id], onDelete: SetNull)
  companyContacts      CompanyContact[]
  attachments          Attachment[]
  evaluations          Evaluation[]

  // SetNull y no Cascade: borrar el original no debe llevarse las copias, que
  // para entonces ya son iniciativas por derecho propio.
  copiedFrom Initiative?  @relation("InitiativeCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies     Initiative[] @relation("InitiativeCopy")

  @@index([userId, updatedAt])
  @@index([status])
  @@index([sourceType])
  @@index([triageClassificationId])
  @@index([triagedAt])
  @@index([copiedFromId])
}

model CompanyContact {
  id           String     @id @default(uuid()) @db.Uuid
  initiativeId String     @db.Uuid
  empresa      String
  contacto     String
  cargo        String
  correo       String
  telefono     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId])
}

model Attachment {
  id           String     @id @default(uuid()) @db.Uuid
  initiativeId String     @db.Uuid
  publicId     String
  secureUrl    String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime   @default(now())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@index([initiativeId])
  @@index([publicId])
}

enum ReadinessStatus {
  INSUFFICIENT
  IN_PROGRESS
  READY
}

model Evaluation {
  id                     String                     @id @default(uuid()) @db.Uuid
  initiativeId           String                     @db.Uuid
  evaluatorId            String?                    @db.Uuid
  status                 EvaluationStatus           @default(PENDING)
  readinessStatus        ReadinessStatus            @default(INSUFFICIENT)
  readiness              Json?
  priority               String?
  configVersion          String?
  /** Versión compartida de la configuración. Nula en las evaluaciones anteriores a que existiera el historial. */
  criteriaVersionId      String?                    @db.Uuid
  criteriaSnapshot       Json?
  weightsSnapshot        Json?
  results                Json?
  classificationSnapshot Json?
  workTableSnapshot      Json?
  businessCase           String?
  recommendations        Json?
  classificationId       String?                    @db.Uuid
  workTableId            String?                    @db.Uuid
  evaluatedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  initiative             Initiative                 @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  evaluator              User?                      @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  classification         IntelligentClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  workTable              WorkTable?                 @relation(fields: [workTableId], references: [id], onDelete: SetNull)
  conversation           Conversation?
  // SetNull: si alguien borrara una versión, la evaluación conserva su propio
  // criteriaSnapshot y sigue siendo auditable por sí sola.
  criteriaVersion        CriteriaVersion?           @relation(fields: [criteriaVersionId], references: [id], onDelete: SetNull)

  @@index([initiativeId, createdAt])
  @@index([evaluatorId])
  @@index([criteriaVersionId])
}

model Conversation {
  id           String             @id @default(uuid()) @db.Uuid
  evaluationId String             @unique @db.Uuid
  title        String?
  status       ConversationStatus @default(COLLECTING_INFORMATION)
  completion   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  evaluation   Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/**
 * Foto de la configuración de criterios en un momento dado.
 *
 * La identidad es el `hash` del contenido, no la fecha: mientras nadie toque los
 * criterios, todas las evaluaciones comparten versión y se pueden comparar entre
 * sí. `configVersion` en Evaluation no sirve para eso porque incluye el instante
 * en que se abrió cada una, así que dos evaluaciones idénticas salían con
 * versiones distintas.
 *
 * `numero` es el identificador legible (v1, v2, …) porque nadie quiere leer un
 * hash en pantalla.
 */
model CriteriaVersion {
  id        String   @id @default(uuid()) @db.Uuid
  numero    Int      @unique
  hash      String   @unique
  /** Criterios activos completos: nombre, descripción, promptContext, peso y orden. */
  snapshot  Json
  totalPeso Float
  createdAt DateTime @default(now())

  evaluations Evaluation[]

  @@index([createdAt])
}

model EvaluationCriteria {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  descripcion   String
  promptContext String
  // Float y no Int porque el enunciado (5.3) declara pesos de 12.5%, ni Decimal
  // porque ese tipo llega a JS como objeto de decimal.js y rompería en silencio
  // las sumas de pesos repartidas por el pipeline. Los pesos son múltiplos de
  // 0.5, exactos en binario; aun así las comparaciones usan tolerancia.
  peso          Float
  activo        Boolean  @default(true)
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activo, orden])
}

model IntelligentClassification {
  id                 String       @id @default(uuid()) @db.Uuid
  nombre             String       @unique
  descripcion        String
  promptContext      String
  activo             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  evaluations        Evaluation[]
  triagedInitiatives Initiative[] @relation("InitiativeTriageClassification")

  @@index([activo])
}

model WorkTable {
  id                 String       @id @default(uuid()) @db.Uuid
  nombre             String       @unique
  descripcion        String
  promptContext      String
  notificationEmail  String?
  activo             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  evaluations        Evaluation[]
  triagedInitiatives Initiative[] @relation("InitiativeTriageWorkTable")

  @@index([activo])
}
